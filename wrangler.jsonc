{
  // Static-assets Worker for brendantscoggin.com. Cloudflare serves the files; Worker code
  // (worker/index.js) runs only for /api/* (the contact form) and the hourly digest cron.
  // Deploy with scripts/deploy.sh, which uploads an export of the committed files.
  // Rollback: GitHub Pages stays enabled as the standby (see README.md).
  "name": "brendantscoggin-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  // No public workers.dev or preview addresses; the site is reached only on its own hostnames.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // deploy.sh passes --assets with a temp export, which replaces this path. A bare
    // `wrangler deploy` fails here on purpose, so nothing but the export is ever uploaded.
    "directory": "./.not-deployed-use-scripts-deploy-sh",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Contact form messages (created 2026-11-08, region WNAM). Local `wrangler dev` uses .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contact-form",
      "database_id": "7fcb4c78-5f36-456f-b3db-206def8ba828",
      "migrations_dir": "migrations"
    }
  ],
  // Hourly check; the digest itself goes out only when the interval set by set-digest has passed.
  "triggers": { "crons": ["0 * * * *"] },
  // Digest email. Locked to one recipient; `wrangler dev` simulates the send and delivers nothing.
  "send_email": [{ "name": "EMAIL", "destination_address": "brendantscoggin@gmail.com" }],
  "routes": [
    // The apex. www is a proxied record plus a redirect rule (zone Single Redirect) to the apex.
    { "pattern": "brendantscoggin.com", "custom_domain": true }
    // Staging: to stage a change, add { "pattern": "stage.brendantscoggin.com", "custom_domain": true }
    // here, run scripts/deploy.sh, then check with scripts/parity.sh and BASE_URL=... npm run verify.
  ]
}
